[Unit]
Description=Gateway tủ chiếu sáng (LOGO! Modbus ↔ MQTT)
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=all
WatchdogSec=60
User=plcgw
EnvironmentFile=/etc/plc-gateway.env
WorkingDirectory=/opt/plc-gateway
ExecStart=/usr/bin/node gateway.js
StateDirectory=plc-gateway
Restart=always
RestartSec=5
# giới hạn quyền
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/plc-gateway
# Hệ điều hành chỉ đọc (overlayfs): /var/lib/plc-gateway PHẢI nằm trên phân vùng ghi được, bền khi cúp điện
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
