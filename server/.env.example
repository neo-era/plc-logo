# ── SERVER ──────────────────────────────────────────────
HTTP_PORT=8080
MQTT_PORT=1883
MQTT_TLS_PORT=8883
DB_PATH=./data/plc.db

# ── SECURITY (đổi tất cả trước khi deploy production) ─
JWT_SECRET=change-me-to-a-random-64-char-string
ADMIN_USER=admin
ADMIN_PASS=ChangeMe!2026

# ── TLS (tùy chọn — nếu muốn MQTT TLS trực tiếp; thường đặt Caddy/Nginx phía trước) ─
TLS_CERT_PATH=
TLS_KEY_PATH=

# ── HISTORY ─────────────────────────────────────────────
HISTORY_RETENTION_DAYS=30
HISTORY_MAX_PER_STATION=10000
